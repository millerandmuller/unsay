# Copy to .env and fill in. Never commit .env.

# --- AssemblyAI (Voice Agent API, pre-recorded STT, LLM Gateway) ---
# Dashboard: https://www.assemblyai.com/app/api-keys
ASSEMBLYAI_API_KEY=
# LLM Gateway model used for promise extraction (see AssemblyAI LLM Gateway docs for current model ids)
LLM_GATEWAY_MODEL=
# Voice for the callback agent
VOICE_AGENT_VOICE=ivy

# --- Twilio (phone bridge: inbound + outbound calls, recording) ---
# Console: https://console.twilio.com (Account Info)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio number in E.164 format, e.g. +12055550123
TWILIO_PHONE_NUMBER=

# --- Demo ---
# The phone that gets called back (team phone only), E.164, e.g. +4915112345678
DEMO_CALLEE_NUMBER=

# --- Server ---
# Public URL Twilio can reach (ngrok locally, Railway/Fly in production), no trailing slash
PUBLIC_BASE_URL=
PORT=8080
DATABASE_PATH=./data/unsay.db
RECORDINGS_DIR=./recordings
